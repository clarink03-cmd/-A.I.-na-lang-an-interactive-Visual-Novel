# game/chapter2.rpy:248
translate english chapter2_effort_q5_correct_a37da479:

    # sys_voice "(Tama! Bakit: VLAN 1 ang default native VLAN sa lahat ng Cisco switch. \nKilalang security risk ang pag-iwan nito as-is, kaya dapat baguhin sa unused VLAN.)"
    sys_voice "(Correct! Why: VLAN 1 is the default native VLAN on every Cisco switch. \nLeaving it as-is is a known security risk, so it should be changed to an unused VLAN.)"

# game/chapter2.rpy:252
translate english chapter2_effort_q5_wrong_5c507a96:

    # sys_voice "(Isipin ang default VLAN na existing sa bawat Cisco switch. \nAng hindi pagbabago nito sa trunk ports ay kilalang security risk sa CCNA.)"
    sys_voice "(Think about the default VLAN that exists on every Cisco switch. \nNot changing it on trunk ports is a known security risk in CCNA.)"

# game/chapter2.rpy:277
translate english chapter2_effort_q6_correct_304bfedb:

    # sys_voice "(Tama! Bakit: 'no vlan 100' sa global config mode ang tanging command \nna talagang bubura ng VLAN 100 mismo, hindi lang tatanggalin sa isang port o trunk.)"
    sys_voice "(Correct! Why: 'no vlan 100' in global config mode is the only command \nthat actually deletes VLAN 100 itself, not just removes it from a port or trunk.)"

# game/chapter2.rpy:281
translate english chapter2_effort_q6_wrong_ec7f492d:

    # sys_voice "('delete flash:vlan.dat' ay bubura ng LAHAT ng VLAN, hindi lang isa. \n'no switchport access/trunk allowed vlan' ay tatanggal lang ng VLAN sa isang interface o trunk, hindi buburahin ang VLAN mismo. Ang 'no vlan <id>' sa global config mode ang siyang bubura ng VLAN talaga.)"
    sys_voice "('delete flash:vlan.dat' deletes ALL VLANs, not just one. \n'no switchport access/trunk allowed vlan' only removes the VLAN from an interface or trunk, it doesn't delete the VLAN itself. 'no vlan <id>' in global config mode is what actually deletes the VLAN.)"

# game/chapter2.rpy:306
translate english chapter2_effort_q7_correct_46f3c89c:

