# game/chapter4.rpy:149
translate english chapter4_subnet_q1_correct_bd625fa2:

    # sys_voice "(Tama! Bakit: 6 host bits ang /26. 2^6 = 64, tanggalin ang network at broadcast = 62 usable.)"
    sys_voice "(Correct! Why: /26 leaves 6 host bits. 2^6 = 64, subtract the network and broadcast addresses = 62 usable.)"

# game/chapter4.rpy:153
translate english chapter4_subnet_q1_wrong_d4e5ab41:

    # sys_voice "(Hindi 'yan. Ang /26 prefix ay nag-iiwan ng 6 host bits. \nI-compute mo ang 2^6, tapos bawasan ng 2 para sa network at broadcast address.)"
    sys_voice "(Not that one. The /26 prefix leaves 6 host bits. \nCompute 2^6, then subtract 2 for the network and broadcast addresses.)"

# game/chapter4.rpy:177
translate english chapter4_subnet_q2_correct_66ae7145:

    # sys_voice "(Tama! Bakit: 24 bits = 255.255.255, dagdag pa ng 4 bits = 240. Kaya ang /28 ay 255.255.255.240, may natitirang 4 host bits.)"
    sys_voice "(Correct! Why: 24 bits = 255.255.255, plus 4 more bits = 240. So /28 is 255.255.255.240, leaving 4 host bits.)"

# game/chapter4.rpy:181
translate english chapter4_subnet_q2_wrong_ba157d0a:

    # sys_voice "(Isipin sa binary. Ang /28 ay nangangahulugang unang 28 bits ay network bits. 24 bits = 255.255.255, tapos 4 pang bits = 240.)"
    sys_voice "(Think in binary. /28 means the first 28 bits are network bits. 24 bits = 255.255.255, then 4 more bits = 240.)"

# game/chapter4.rpy:205
translate english chapter4_subnet_q3_correct_992096b1:

    # sys_voice "(Tama! Bakit: ang pag-hiram ng 2 bits mula /24 ay nagbibigay ng /26, gumagawa ng 4 subnets (2^2), 62 usable hosts bawat isa.)"
    sys_voice "(Correct! Why: borrowing 2 bits from /24 gives you /26, creating 4 subnets (2^2), 62 usable hosts each.)"

# game/chapter4.rpy:209
translate english chapter4_subnet_q3_wrong_bb2751bf:

    # sys_voice "(Para gumawa ng 4 subnets, kailangan mo ng sapat na bits. \n2 bits = 4 subnets. Mula /24, ang paghiram ng 2 ay nagbibigay ng /26.)"
    sys_voice "(To create 4 subnets, you need enough bits. \n2 bits = 4 subnets. From /24, borrowing 2 gives you /26.)"

# game/chapter4.rpy:233
translate english chapter4_subnet_q4_correct_25917750:

    # sys_voice "(Tama! Bakit: /20 = 255.255.240.0, block size na 16 bawat subnet. \nNagsisimula sa 172.16.32.0 ang subnet 3, kaya 172.16.47.255 ang broadcast.)"
    sys_voice "(Correct! Why: /20 = 255.255.240.0, block size of 16 per subnet. \nSubnet 3 starts at 172.16.32.0, so 172.16.47.255 is the broadcast address.)"

# game/chapter4.rpy:237
translate english chapter4_subnet_q4_wrong_601b31b0:

    # sys_voice "(Sa /20 mask, 16 ang block size sa third octet. \nSubnet 0 = 172.16.0.0, Subnet 1 = .16.0, Subnet 2 = .32.0. Ang broadcast ay 'yung susunod na subnet, minus 1.)"
    sys_voice "(With a /20 mask, the block size in the third octet is 16. \nSubnet 0 = 172.16.0.0, Subnet 1 = .16.0, Subnet 2 = .32.0. The broadcast address is the next subnet, minus 1.)"

# game/chapter4.rpy:261
translate english chapter4_subnet_q5_correct_825806b8:

    # sys_voice "(Tama! Bakit: /27 = 255.255.255.224. Ang wildcard ay inverse ng mask = 0.0.0.31.)"
    sys_voice "(Correct! Why: /27 = 255.255.255.224. The wildcard is the inverse of the mask = 0.0.0.31.)"

# game/chapter4.rpy:265
translate english chapter4_subnet_q5_wrong_f060dafa:

    # sys_voice "(Ang wildcard mask ay inverse ng subnet mask. \nPara sa /27 = 255.255.255.224. Bawasan ang 255 sa bawat octet.)"
    sys_voice "(The wildcard mask is the inverse of the subnet mask. \nFor /27 = 255.255.255.224. Subtract each octet from 255.)"

# game/chapter4.rpy:290
translate english chapter4_subnet_q6_correct_78a3fcfa:

    # sys_voice "(Tama! Bakit: 'boot system' ang command na nagse-set ng BOOT environment variable.\n Ang config-register/confreg ay para sa configuration register, hindi para dito.)"
    sys_voice "(Correct! Why: 'boot system' is the command that sets the BOOT environment variable.\n config-register/confreg is for the configuration register, not this.)"

# game/chapter4.rpy:294
translate english chapter4_subnet_q6_wrong_cb725a0c:

    # sys_voice "(Hindi 'yan. Ang 'boot system' ang command na nagta-take charge ng BOOT environment variable.\n 'config-register' at 'confreg' ay para sa ibang bagay, ang configuration register.)"
    sys_voice "(Not that one. 'boot system' is the command that handles the BOOT environment variable.\n 'config-register' and 'confreg' are for something else, the configuration register.)"

# game/chapter4.rpy:319
