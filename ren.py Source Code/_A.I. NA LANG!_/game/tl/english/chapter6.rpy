# game/chapter6.rpy:136
translate english chapter6_cyber_q1_correct_28411619:

    # narrator "(Tama! Bakit: ang right to access ay isa sa mga karapatan ng data subject sa RA 10173, \nang karapatang malaman at makuha ang kopya ng sariling personal data na hawak ng isang organisasyon.)"
    narrator "(Correct! Why: the right to access is one of the data subject's rights under RA 10173, \nthe right to know and obtain a copy of your own personal data held by an organization.)"

# game/chapter6.rpy:140
translate english chapter6_cyber_q1_wrong_1b3b1f01:

    # narrator "(Hindi 'yan. Isipin kung ano ang natural na karapatan ng may-ari ng datos, hindi ng kumpanyang humahawak nito.)"
    narrator "(Not that one. Think about what right naturally belongs to the owner of the data, not the company holding it.)"

# game/chapter6.rpy:164
translate english chapter6_cyber_q2_correct_aede06b3:

    # narrator "(Tama! Bakit: ang acceptable use policy ang nagtatakda ng access \nat usage rules ng network resources, kasama ang consequences ng violations.)"
    narrator "(Correct! Why: the acceptable use policy is what sets the access \nand usage rules for network resources, including the consequences for violations.)"

# game/chapter6.rpy:168
translate english chapter6_cyber_q2_wrong_6054c90e:

    # narrator "(Hindi 'yan. Ang password policy ay para sa password requirements, \nremote access policy naman ay para sa pag-konekta mula sa labas. May specific policy para sa general usage rules at consequences.)"
    narrator "(Not that one. The password policy is for password requirements, \nand the remote access policy is for connecting from outside. There's a specific policy for general usage rules and consequences.)"

# game/chapter6.rpy:192
translate english chapter6_cyber_q3_correct_8ba82497:

    # narrator "(Tama! Bakit: ang ISO/IEC 27000 ang standard family na nagtatakda ng comprehensive\n information security management system, hindi lang isang model o triad.)"
    narrator "(Correct! Why: ISO/IEC 27000 is the standard family that defines a comprehensive\n information security management system, not just a single model or triad.)"

# game/chapter6.rpy:196
translate english chapter6_cyber_q3_wrong_9528eedb:

    # narrator "(Hindi 'yan. Ang CIA Triad ay isang konsepto lang (confidentiality, integrity, availability), \nhindi isang buong management framework. May specific na ISO family para dito.)"
    narrator "(Not that one. The CIA Triad is just a concept (confidentiality, integrity, availability), \nnot a full management framework. There's a specific ISO family for this.)"

# game/chapter6.rpy:220
translate english chapter6_cyber_q4_correct_a329f068:

    # narrator "(Tama! Bakit: ang Computer Fraud and Abuse Act (CFAA) ang nagbibigay ng foundation \npara sa mga batas laban sa unauthorized access ng computer systems.)"
    narrator "(Correct! Why: the Computer Fraud and Abuse Act (CFAA) is what provides the foundation \nfor laws against unauthorized access to computer systems.)"

# game/chapter6.rpy:224
translate english chapter6_cyber_q4_wrong_805e5119:

    # narrator "(Hindi 'yan. Ang SOX ay para sa financial reporting, GLBA para sa financial institutions, \nECPA para sa electronic communications. May specific act para sa unauthorized computer access.)"
    narrator "(Not that one. SOX is for financial reporting, GLBA is for financial institutions, \nECPA is for electronic communications. There's a specific act for unauthorized computer access.)"

# game/chapter6.rpy:248
translate english chapter6_cyber_q5_correct_809bdf44:

    # narrator "(Tama! Bakit: ang penetration testing ay gumagamit ng simulated attacks \npara malaman ang posibleng consequences ng isang tunay na threat. Iba 'yan sa vulnerability scanning, na naghahanap lang ng weaknesses.)"
    narrator "(Correct! Why: penetration testing uses simulated attacks \nto find out the possible consequences of a real threat. That's different from vulnerability scanning, which just looks for weaknesses.)"

# game/chapter6.rpy:252
translate english chapter6_cyber_q5_wrong_34f8c8e6:

    # narrator "(Hindi 'yan. Ang vulnerability scanning ay naghahanap lang ng weaknesses, \nhindi sumusubok ng simulated attack. May specific test na gumagaya ng aktwal na atake.)"
    narrator "(Not that one. Vulnerability scanning only looks for weaknesses, \nit doesn't attempt a simulated attack. There's a specific test that mimics an actual attack.)"

# game/chapter6.rpy:276
translate english chapter6_cyber_q6_correct_17badc1f:

    # narrator "(Tama! Bakit: ang MITRE Corporation ang nag-maintain ng \nCVE list na ginagamit ng mga prominent security organizations sa buong mundo.)"
    narrator "(Correct! Why: MITRE Corporation is the one that maintains the \nCVE list used by prominent security organizations around the world.)"

# game/chapter6.rpy:280
translate english chapter6_cyber_q6_wrong_ba4ed000:

    # narrator "(Hindi 'yan. Ang SANS ay kilala sa NewsBites digest, hindi CVE list. \nMay specific na organization na siyang nag-maintain ng CVE database.)"
    narrator "(Not that one. SANS is known for the NewsBites digest, not the CVE list. \nThere's a specific organization that maintains the CVE database.)"

# game/chapter6.rpy:304
translate english chapter6_cyber_q7_correct_3466f49f:

    # narrator "(Tama! Bakit: preventive controls ang nag-aapply ng restrictions para pigilan \nang unauthorized activities bago pa man ito mangyari, tulad ng ID card locks.)"
    narrator "(Correct! Why: preventive controls apply restrictions to stop \nunauthorized activities before they even happen, like ID card locks.)"

